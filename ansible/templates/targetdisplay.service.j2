[Unit]
Description=TargetDisplay X11 Kiosk-Session
After=systemd-user-sessions.service getty@tty1.service network.target
Conflicts=getty@tty1.service
# Beendet sich main.py (z.B. weil der Kamera-Stream seit STREAM_STALE_TIMEOUT_SEC
# ohne neuen Frame ist, siehe camera.py::is_stale/main.py), endet play_it
# (letzter Befehl in .xinitrc) -> die X11-Session endet -> Restart=always
# startet den Dienst neu. Gezaehlt werden dabei die Starts, nicht die
# Exit-Codes (siehe SuccessExitStatus unten): nach StartLimitBurst Starts
# innerhalb von StartLimitIntervalSec gibt systemd auf und ruft OnFailure=
# auf - naechste Eskalationsstufe: Pi-Reboot mit persistenter Obergrenze.
# play_it zaehlt selbst nicht mit (siehe play_it). Auch manuelle Neustarts
# (systemctl restart) und der Neustart nach dem Speichern der Einstellungen
# zaehlen als Start.
#
# Bei ausbleibendem Stream dauert ein Zyklus rund 36 s: 30 s Startup-Frist
# (STREAM_STARTUP_TIMEOUT_SEC - der neu gestartete Prozess hat noch keinen
# Frame) + RestartSec + X11-Start. 5 Zyklen brauchen damit rund 180 s. Das
# Intervall liegt deutlich darueber, damit die Eskalation nicht von wenigen
# Sekunden Streuung abhaengt.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=targetdisplay-reboot.service

[Service]
Type=simple
User={{ targetdisplay_service_user }}
Group={{ targetdisplay_service_user }}
# KEIN PAMName=login: PAMName= wuerde eine eigene logind-Session
# registrieren, deren Prozesse (Xorg, python3, matchbox) dadurch in einer
# SEPARATEN Cgroup (/user.slice/user-*.slice/session-N.scope) liefen statt
# in der Cgroup dieses Service (/system.slice/targetdisplay.service).
# systemds KillMode=control-group (Default) signalisiert bei "systemctl
# stop/restart" dadurch nur die (fast leere) Service-Cgroup - die
# eigentliche Last bekaeme nie ein SIGTERM, der Stop wuerde bis
# TimeoutStopSec (90s) haengen und dann per SIGKILL erzwungen. Ein
# erzwungener Stop zaehlt fuer systemd als "Failed with result 'timeout'"
# und loest SOFORT OnFailure=/den Reboot-Guard aus - bei ganz normalen
# "systemctl restart"-Aufrufen waeren das sonst spontane Reboots.
#
# Geraete-Zugriff (video/render/input) laeuft deshalb ausschliesslich ueber
# die Gruppenmitgliedschaften des Service-Users (siehe tasks/base.yml) -
# ohne eigene PAM-Session ist das die alleinige Quelle der noetigen
# Seat-Berechtigungen.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HOME=/home/{{ targetdisplay_service_user }}
ExecStart=/usr/bin/startx /home/{{ targetdisplay_service_user }}/.xinitrc -- :0 vt1
# Bei "systemctl stop/restart" bekommt xinit (KillMode=control-group,
# Default) direkt selbst ein SIGTERM und wertet das als "unexpected signal" -
# es beendet sich dabei zuverlaessig mit Exit-Code 1, obwohl der Stop völlig
# regulaer ist (kein Absturz). Ein eigenes ExecStop, das gezielt nur main.py
# signalisiert, wuerde das Problem nicht loesen: ExecStop ersetzt systemds
# eigene KillMode-Signale nicht, sie laufen zusaetzlich/danach - xinit
# bekommt das SIGTERM so oder so.
#
# Deshalb stattdessen: Exit-Code 1 pauschal als Erfolg werten. Der Exit-Code
# von main.py erreicht systemd nicht: xinit beendet sich nach dem Ende des
# Clients immer mit 0, auch wenn main.py mit 2 (Stream-Ausfall) oder 3
# (unbehandelte Exception) endet. Dass der Dienst dann neu startet, liegt an
# Restart=always, und die Eskalation zaehlt Starts (StartLimit*), nicht
# Fehlercodes. Den Exit-Code von main.py protokolliert play_it im Journal
# ("TargetDisplay beendet (exit N)").
SuccessExitStatus=1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
