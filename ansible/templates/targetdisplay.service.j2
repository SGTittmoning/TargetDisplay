[Unit]
Description=TargetDisplay X11 Kiosk-Session
After=systemd-user-sessions.service getty@tty1.service network.target
Conflicts=getty@tty1.service
# Beendet sich main.py (z.B. weil der Kamera-Stream seit STREAM_STALE_TIMEOUT_SEC
# ohne neuen Frame ist, siehe camera.py::is_stale/main.py), endet play_it
# (letzter Befehl in .xinitrc) -> die X11-Session endet -> Restart=always
# startet den Dienst neu. Gezaehlt werden dabei die Starts, nicht die
# Exit-Codes (siehe SuccessExitStatus unten): nach StartLimitBurst Starts
# innerhalb von StartLimitIntervalSec gibt systemd auf und ruft OnFailure=
# auf - naechste Eskalationsstufe: Pi-Reboot mit persistenter Obergrenze.
# play_it zaehlt selbst nicht mit (siehe play_it). Auch manuelle Neustarts
# (systemctl restart) und der Neustart nach dem Speichern der Einstellungen
# zaehlen als Start.
#
# Bei ausbleibendem Stream dauert ein Zyklus rund 36 s: 30 s Startup-Frist
# (STREAM_STARTUP_TIMEOUT_SEC - der neu gestartete Prozess hat noch keinen
# Frame) + RestartSec + X11-Start. 5 Zyklen brauchen damit rund 180 s. Das
# Intervall liegt deutlich darueber, damit die Eskalation nicht von wenigen
# Sekunden Streuung abhaengt.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=targetdisplay-reboot.service

[Service]
Type=simple
User={{ targetdisplay_service_user }}
Group={{ targetdisplay_service_user }}
# Kein PAMName=login: die eigene logind-Session laege in einer anderen
# Cgroup, "systemctl stop/restart" erreichte Xorg und main.py nicht, der
# Stop liefe in den Timeout und loeste OnFailure= (Reboot) aus. Den
# Geraetezugriff (video/render/input) regeln deshalb allein die Gruppen des
# Dienst-Benutzers (tasks/base.yml).
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HOME=/home/{{ targetdisplay_service_user }}
ExecStart=/usr/bin/startx /home/{{ targetdisplay_service_user }}/.xinitrc -- :0 vt1
# xinit endet bei "systemctl stop/restart" durch das SIGTERM mit Exit-Code 1,
# obwohl der Stop regulaer ist; 1 gilt deshalb als Erfolg. Der Exit-Code von
# main.py erreicht systemd ohnehin nicht (xinit endet nach dem Client mit 0),
# play_it schreibt ihn ins Journal. Neustart und Eskalation haengen an
# Restart=always und der Zahl der Starts, nicht an Fehlercodes.
SuccessExitStatus=1
Restart=always
RestartSec=2

# Sandbox: begrenzt, was ein kompromittierter App-Prozess (z.B. ueber einen
# Fehler im Video-Decoder) am System veraendern kann. Beschreibbar bleiben
# nur das Home-Verzeichnis (App, venv, .Xauthority), /boot/firmware (die
# sudo-Speicherskripte laufen im selben Mount-Namespace) und /var/log
# (Xorg schreibt dort sein Log).
# Bewusst nicht: NoNewPrivileges (bricht die sudo-Skripte), PrivateDevices
# (Grafik und Touch), ProtectHome (App liegt unter /home).
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/{{ targetdisplay_service_user }} /boot/firmware /var/log
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
