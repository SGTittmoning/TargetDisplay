#!/usr/bin/env bash

xset s off -dpms &

matchbox-window-manager &

# exec statt einfachem Aufruf: ersetzt diese Shell durch play_it, statt
# play_it als Kindprozess zu starten - weniger Prozess-Verschachtelung
# zwischen dem von systemd/xinit verfolgten Prozess und der eigentlichen
# App, siehe play_it fuer die Fortsetzung der Kette.
exec /home/{{ targetdisplay_service_user }}/TargetDisplay/play_it
