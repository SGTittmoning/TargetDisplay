{#- Flottenweite Liste plus optionale Zusatzstaende eines einzelnen Hosts
    (targetdisplay_extra_stands, z.B. ein Teststand nur fuer das Testgeraet). -#}
{% set stands = targetdisplay_stands + (targetdisplay_extra_stands | default([])) %}
{
  "stands": [
{% for stand in stands %}
    {"id": {{ stand.id | to_json }}, "displayName": {{ stand.displayName | to_json }}, "url": {{ stand.url | to_json }}}{{ "," if not loop.last }}
{% endfor %}
  ]
}
