targetdisplay:
  vars:
    ansible_python_interpreter: /usr/bin/python3
    ntpserver: 192.0.2.1  # your local NTP source, if the stands have no internet access
    # Optional: Boot-Logo (Plymouth) ist standardmaessig AN. Abschalten mit
    # targetdisplay_boot_splash: false (hier fuer alle Geraete oder unter einem
    # einzelnen Host). Eigenes Bild: ansible/files/splash.png auf dem
    # Control-Rechner, sonst das App-Logo. Siehe ansible/README.md.
    # targetdisplay_boot_splash: false
    # Quelle des App-Codes. Das Repo ist oeffentlich, die URL braucht keine
    # Zugangsdaten. Bei einem privaten Fork stattdessen eine SSH-URL
    # (git@host:org/TargetDisplay.git) mit einem reinen Lese-Deploy-Key fuer den
    # Service-User verwenden: Zugangsdaten in der URL landen in .git/config
    # auf jedem Geraet (siehe die Pruefung in install.yml).
    targetdisplay_git_repo: "https://github.com/SGTittmoning/TargetDisplay.git"
    # Flottenweite Liste aller Staende - identisch an jeden Host in dieser
    # Gruppe ausgerollt (siehe tasks/stands.yml), landet als
    # targetdisplay-stands.json auf /boot/firmware. Welchen Stand ein
    # konkretes Geraet zeigt, wird NICHT hier festgelegt, sondern einmalig
    # am Geraet selbst im (erzwungenen) Ersteinrichtungs-Assistenten
    # ausgewaehlt - dieselbe Liste funktioniert dadurch fuer beliebig viele
    # Staende/Vereine, ohne Codeaenderung oder Pro-Host-Variablen.
    targetdisplay_stands:
      - id: stand1
        displayName: "Stand 1"
        url: "rtmp://user:pass@camera-host:1935/bcs/channel0_main.bcs?channel=0&stream=0&user=admin&password=CHANGEME"
      - id: stand2
        displayName: "Stand 2"
        url: "rtmp://user:pass@camera-host2:1935/bcs/channel0_main.bcs?channel=0&stream=0&user=admin&password=CHANGEME"
      # - id: stand3
      #   displayName: "Stand 3"
      #   url: "..."
  hosts:
    stand1.example.lan:
      ansible_host: 192.0.2.21
      ansible_user: pi
      # Optional - fehlt sie, startet das Geraet mit dem eingebauten
      # Standard-PIN "1234" und erzwingt eine PIN-Aenderung im
      # Ersteinrichtungs-Assistenten, bevor es in den Normalbetrieb geht.
      # my_settings_pin: "CHANGEME"  # 4-6 stelliger numerischer PIN
    # Optional: eigene Touch-Kalibrierdatei fuer ein Geraet mit anderem
    # Touch-Controller (Datei unter ansible/files/, Standard ist
    # 99-calibration.conf):
    # stand2.example.lan:
    #   targetdisplay_touch_calibration_file: 99-calibration.conf.stand2
    # stand2.example.lan: ...
    # stand3.example.lan: ...
    # stand4.example.lan: ...
    # stand5.example.lan: ...
    # Beispiel Test-/Entwicklungsgeraet in einem ANDEREN Netzsegment als die
    # produktiven Staende (z.B. ohne Route zum Kamera-VLAN, in dem der
    # gruppenweite "ntpserver" oben liegt) - eine Host-Variable ueberschreibt
    # hier gezielt nur fuer dieses eine Geraet, ohne die anderen Hosts zu
    # beeinflussen (Ansible-Variablenpraezedenz: host_vars schlagen group_vars).
    # testpi.example.lan:
    #   ansible_host: 192.0.2.99
    #   ansible_user: pi
    #   ntpserver: 192.0.2.1  # NTP-Quelle erreichbar aus DIESEM Netzsegment
