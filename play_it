#!/bin/bash

cd "$(dirname "$(readlink -f "$0")")" || exit 1

# Keine eigene Log-Datei: stdout/stderr von main.py landen ueber den Dienst
# im Journal ("journalctl -u targetdisplay.service").
echo "Starting up TargetDisplay..."

# Kein eigener Neuversuch: Neustart und Eskalation regelt
# targetdisplay.service.j2. Der Exit-Code von main.py erreicht systemd nicht
# (xinit reicht ihn nicht weiter), er steht nur in der Journal-Zeile unten.
.venv/bin/python3 ./main.py
RET=$?

echo "TargetDisplay beendet (exit ${RET})."
exit "${RET}"
