# ansible-lint fuer die Playbooks unter ansible/.
#
# Stil-Regeln sind bewusst abgeschaltet: Kurzformen wie "apt:" statt
# "ansible.builtin.apt:", Gross-/Kleinschreibung von Task-Namen und "yes"
# statt "true" wuerden einen Massen-Umbau der auf Hardware getesteten Playbooks
# ohne inhaltlichen Nutzen erfordern. Aktiv bleiben die Regeln, die echte
# Fehler finden (Syntax, Idempotenz-Angaben, riskante Dateirechte, ...).
skip_list:
  - fqcn
  - name[casing]
  - name[missing]
  - name[template]
  - name[play]
  - yaml[truthy]
  - yaml[line-length]
  # Reboots muessen inline laufen und nicht als Handler am Playende: alles, was
  # einen Reboot ausloesen kann, muss VOR dem Start des Dienstes passieren
  # (siehe Kommentar in install.yml).
  - no-handler
  # "systemctl is-active" ist eine reine Abfrage; das systemd-Modul kann das
  # nicht als Pruefung ausdruecken.
  - command-instead-of-module

# Bestehende Befunde in den auf Hardware getesteten Playbooks: sichtbar als
# Warnung, aber nicht CI-brechend. Ein Umbau (become, Dateirechte, changed_when)
# aendert Verhalten auf den Geraeten und gehoert in einen eigenen, getesteten
# Change - nicht in die CI-Einfuehrung.
warn_list:
  - risky-file-permissions
  - partial-become[task]
  - no-changed-when
